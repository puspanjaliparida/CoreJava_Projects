		System.out.println(x +" "+ y);
		x = x;
		y = y;
		System.out.println(x +" "+ y);	
	}
	public static void main(String[] args) {
		Test t = new Test();
		t.display(30,40);
		System.out.println(t.x + " " + t.y);
	}
}
