16) What is the output of the below program? 
 class Complex 
{
    private  double re,  im;//re=10.0,im=15.0
    public Complex(double re, double im)//10.0 ,15.0
  {
        this.re = re;
        this.im = im;
    }
    Complex(Complex c) //c=1000x
    {
      System.out.println("Copy constructor called");
      re = c.re;//re=10.0,im=15.0
      im = c.im;
    }            
    public String toString()
  {
        return "(" + re + " + " + im + ")";
    }            
}
class Main
 {
    public static void main(String[] args) 
   {
        Complex c1 = new Complex(10, 15);
        Complex c2 = new Complex(c1);    
        Complex c3 = c1;  
        System.out.println(c2);
    }
}

Answer:Copy constructor called
       (10.0 + 15.0)

